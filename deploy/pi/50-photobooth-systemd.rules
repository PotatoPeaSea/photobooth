// Let the photobooth print server (user pi) stop, start and restart the webcam feed from the
// staff panel's Debug tab. Only photobooth-webcam.service; no other unit.
// Check on the Pi with: pkaction --action-id org.freedesktop.systemd1.manage-units --verbose
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "photobooth-webcam.service" &&
      ["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0 &&
      subject.user == "pi") {
    return polkit.Result.YES;
  }
});
